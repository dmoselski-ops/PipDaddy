bool IsXAUUSDSymbol() { return StringFind(_Symbol, "XAU") >= 0 || StringFind(_Symbol, "GOLD") >= 0; }
bool IsBitcoinSymbol() { return StringFind(_Symbol, "BTC") >= 0 || StringFind(_Symbol, "XBT") >= 0; }
bool IsUSDJPYSymbol() { return StringFind(_Symbol, "USDJPY") >= 0; }
bool IsIndexSymbol() { return StringFind(_Symbol, "US30") >= 0 || StringFind(_Symbol, "NAS") >= 0; }

//+------------------------------------------------------------------+
//| GET ACTIVE STRATEGY                                               |
//+------------------------------------------------------------------+
ENUM_STRATEGY_MODE GetActiveStrategy()
{
   if(StrategyMode != STRATEGY_AUTO)
      return StrategyMode;
   
   if(IsXAUUSDSymbol()) return XAUUSD_Strategy;
   if(IsIndexSymbol()) return Index_Strategy;
   return Forex_Strategy;
}

string GetStrategyName()
{
   ENUM_STRATEGY_MODE strat = GetActiveStrategy();
   if(strat == STRATEGY_TREND) return "TREND";
   if(strat == STRATEGY_SMC) return "SMC";
   return "AUTO";
}

//+------------------------------------------------------------------+
//| GET FILLING MODE                                                  |
//+------------------------------------------------------------------+
ENUM_ORDER_TYPE_FILLING GetFillingMode()
{
   uint filling = (uint)SymbolInfoInteger(_Symbol, SYMBOL_FILLING_MODE);
   
   if((filling & SYMBOL_FILLING_FOK) == SYMBOL_FILLING_FOK)
      return ORDER_FILLING_FOK;
   if((filling & SYMBOL_FILLING_IOC) == SYMBOL_FILLING_IOC)
      return ORDER_FILLING_IOC;
   
   return ORDER_FILLING_RETURN;
}

//+------------------------------------------------------------------+
//| VALIDATION HELPERS                                                |
//+------------------------------------------------------------------+
bool ValidateRiskReward(TradeSignal &signal)
{
   double risk = MathAbs(signal.entry - signal.sl);
   double reward = MathAbs(signal.tp - signal.entry);
   
   if(risk == 0) return false;
   
   return (reward / risk >= Risk_MinRR);
}

int CountOpenPositions()
{
   int count = 0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      if(PositionGetTicket(i) > 0 && 
         PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == Config_MagicNumber)
         count++;
   }
   return count;
}

//+------------------------------------------------------------------+
//| DAILY MANAGEMENT                                                  |
//+------------------------------------------------------------------+
datetime GetCurrentDay()
{
   return TimeCurrent() - (TimeCurrent() % 86400);
}

void CheckDailyReset()
{
   datetime today = GetCurrentDay();
   if(today != g_currentDay)
   {
      Print("═══════════════════════════════════════");
      Print("📅 NEW DAY");
      Print("Previous P&L: $", DoubleToString(g_dailyPnL, 2));
      Print("Trades: ", g_dailyTradeCount);
      Print("═══════════════════════════════════════");
      
      g_currentDay = today;
      g_dailyTradeCount = 0;
      g_dailyPnL = 0;
      g_dailyStartBalance = AccountInfoDouble(ACCOUNT_BALANCE);
      
      ArrayResize(g_lastAlertLevel, 0);
      ArrayResize(g_alertTickets, 0);
   }
}

void UpdateDailyPnL()
{
   double openProfit = 0;
   for(int i = 0; i < PositionsTotal(); i++)
   {
      if(PositionGetTicket(i) > 0 && 
         PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == Config_MagicNumber)
         openProfit += PositionGetDouble(POSITION_PROFIT);
   }
   
   double closedProfit = 0;
   if(HistorySelect(g_currentDay, TimeCurrent()))
   {
      for(int i = HistoryDealsTotal() - 1; i >= 0; i--)
      {
         ulong ticket = HistoryDealGetTicket(i);
         if(ticket > 0 && 
            HistoryDealGetString(ticket, DEAL_SYMBOL) == _Symbol &&
            HistoryDealGetInteger(ticket, DEAL_MAGIC) == Config_MagicNumber)
            closedProfit += HistoryDealGetDouble(ticket, DEAL_PROFIT);
      }
   }
   
   g_dailyPnL = openProfit + closedProfit;
}

//+------------------------------------------------------------------+
//| MARKET ANALYSIS                                                   |
//+------------------------------------------------------------------+
void AnalyzeMarket()
{
   // Determine market condition
   if(g_cache.fastMA > g_cache.slowMA && g_cache.rsi < 50)
      g_market.status = "Bullish Pullback";
   else if(g_cache.fastMA > g_cache.slowMA)
      g_market.status = "Strong Uptrend";
   else if(g_cache.fastMA < g_cache.slowMA && g_cache.rsi > 50)
      g_market.status = "Bearish Pullback";
   else if(g_cache.fastMA < g_cache.slowMA)
      g_market.status = "Strong Downtrend";
   else
      g_market.status = "Ranging";
   
   g_market.rsiValue = g_cache.rsi;
   g_market.trendUp = (g_cache.fastMA > g_cache.slowMA);
   
   // OB Status
   if(g_bullishOB.strength >= SMC_OB_MinStrength)
      g_market.obStatus = "Bull OB " + DoubleToString(g_bullishOB.strength, 1);
   else if(g_bearishOB.strength >= SMC_OB_MinStrength)
      g_market.obStatus = "Bear OB " + DoubleToString(g_bearishOB.strength, 1);
   else
      g_market.obStatus = "No valid OB";
}

