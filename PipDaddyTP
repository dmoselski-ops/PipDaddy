//+------------------------------------------------------------------+
//| UPDATE INFO PANEL                                                 |
//+------------------------------------------------------------------+
void UpdateInfoPanel()
{
   string prefix = "PD_";
   
   if(ObjectFind(0, prefix+"BG") < 0)
      return;
   
   // Strategy
   ObjectSetString(0, prefix+"Strategy", OBJPROP_TEXT, GetStrategyName() + " 🎯");
   ObjectSetInteger(0, prefix+"Strategy", OBJPROP_COLOR, clrLimeGreen);
   
   // Spread
   long spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   double spreadPips = spread * SymbolInfoDouble(_Symbol, SYMBOL_POINT) / 
                       (SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10);
   color spreadColor = spreadPips > Filter_MaxSpread ? clrRed : clrLimeGreen;
   ObjectSetString(0, prefix+"Spread", OBJPROP_TEXT, DoubleToString(spreadPips, 1) + " pips");
   ObjectSetInteger(0, prefix+"Spread", OBJPROP_COLOR, spreadColor);
   
   // Scanning animation
   string dots = "";
   for(int i = 0; i < (g_scanCounter % 4); i++) dots += ".";
   ObjectSetString(0, prefix+"Scanning", OBJPROP_TEXT, "⏺ Scanning" + dots);
   ObjectSetInteger(0, prefix+"Scanning", OBJPROP_COLOR, (g_scanCounter % 2 == 0) ? clrYellow : clrOrange);
   
   // Market analysis
   color marketColor = clrGray;
   if(StringFind(g_market.status, "Uptrend") >= 0 || StringFind(g_market.status, "Bullish") >= 0)
      marketColor = clrLimeGreen;
   else if(StringFind(g_market.status, "Downtrend") >= 0 || StringFind(g_market.status, "Bearish") >= 0)
      marketColor = clrOrangeRed;
   else
      marketColor = clrYellow;
   
   ObjectSetString(0, prefix+"Market", OBJPROP_TEXT, g_market.status);
   ObjectSetInteger(0, prefix+"Market", OBJPROP_COLOR, marketColor);
   
   // RSI
   color rsiColor = clrGray;
   if(g_market.rsiValue > Trend_RSI_High)
      rsiColor = clrOrangeRed;
   else if(g_market.rsiValue < Trend_RSI_Low)
      rsiColor = clrLimeGreen;
   else
      rsiColor = clrYellow;
   
   ObjectSetString(0, prefix+"RSI", OBJPROP_TEXT, "RSI: " + DoubleToString(g_market.rsiValue, 1));
   ObjectSetInteger(0, prefix+"RSI", OBJPROP_COLOR, rsiColor);
   
   // Trend
   string trendText = g_market.trendUp ? "UP ↗" : "DOWN ↘";
   color trendColor = g_market.trendUp ? clrLimeGreen : clrOrangeRed;
   ObjectSetString(0, prefix+"Trend", OBJPROP_TEXT, trendText);
   ObjectSetInteger(0, prefix+"Trend", OBJPROP_COLOR, trendColor);
   
   // OB
   color obColor = clrGray;
   if(StringFind(g_market.obStatus, "Bull") >= 0)
      obColor = clrLimeGreen;
   else if(StringFind(g_market.obStatus, "Bear") >= 0)
      obColor = clrOrangeRed;
   
   ObjectSetString(0, prefix+"OB", OBJPROP_TEXT, g_market.obStatus);
   ObjectSetInteger(0, prefix+"OB", OBJPROP_COLOR, obColor);
   
   // Account
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   
   ObjectSetString(0, prefix+"Balance", OBJPROP_TEXT, "Bal: $" + DoubleToString(balance, 0));
   
   color eqColor = equity >= balance ? clrLimeGreen : clrOrange;
   ObjectSetString(0, prefix+"Equity", OBJPROP_TEXT, "Eq: $" + DoubleToString(equity, 0));
   ObjectSetInteger(0, prefix+"Equity", OBJPROP_COLOR, eqColor);
   
   // Next lot
   double nextLot = CalculateSmartLotSize(SymbolInfoDouble(_Symbol, SYMBOL_BID), 
                                          SymbolInfoDouble(_Symbol, SYMBOL_BID) - g_cache.atr);
   nextLot = AdjustLotForSymbol(nextLot);
   ObjectSetString(0, prefix+"NextLot", OBJPROP_TEXT, "Next: " + DoubleToString(nextLot, 2));
   
   // Stats
   ObjectSetString(0, prefix+"Trades", OBJPROP_TEXT, 
                   IntegerToString(g_dailyTradeCount) + "/" + IntegerToString(Risk_MaxTradesPerDay));
   
   color pnlColor = g_dailyPnL >= 0 ? clrLimeGreen : clrRed;
   ObjectSetString(0, prefix+"PnL", OBJPROP_TEXT, "$" + DoubleToString(g_dailyPnL, 2));
   ObjectSetInteger(0, prefix+"PnL", OBJPROP_COLOR, pnlColor);
   
   int openPos = CountOpenPositions();
   ObjectSetString(0, prefix+"Positions", OBJPROP_TEXT, 
                   IntegerToString(openPos) + "/" + IntegerToString(Pos_MaxOpen));
}

//+------------------------------------------------------------------+
//| DISPLAY SIGNAL INFO                                               |
//+------------------------------------------------------------------+
void DisplaySignalInfo(TradeSignal &signal)
{
   string prefix = "PD_";
   
   if(ObjectFind(0, prefix+"SigStatus") < 0)
      return;
   
   string statusText = signal.direction == 1 ? "🟢 BUY" : "🔴 SELL";
   color statusColor = signal.direction == 1 ? clrLimeGreen : clrOrangeRed;
   
   ObjectSetString(0, prefix+"SigStatus", OBJPROP_TEXT, statusText);
   ObjectSetInteger(0, prefix+"SigStatus", OBJPROP_COLOR, statusColor);
   
   // Truncate reason if needed
   string reason = signal.reason;
   if(StringLen(reason) > 45)
      reason = StringSubstr(reason, 0, 42) + "...";
   
   ObjectSetString(0, prefix+"SigReason", OBJPROP_TEXT, reason);
   ObjectSetInteger(0, prefix+"SigReason", OBJPROP_COLOR, clrWhite);
   
   color confColor = clrYellow;
   if(signal.confidence >= 85) confColor = clrLimeGreen;
   else if(signal.confidence < 65) confColor = clrOrange;
   
   ObjectSetString(0, prefix+"SigConf", OBJPROP_TEXT, DoubleToString(signal.confidence, 0) + "%");
   ObjectSetInteger(0, prefix+"SigConf", OBJPROP_COLOR, confColor);
   
   // Print to terminal
   Print("═══════════════════════════════════════");
   Print("📊 ", signal.direction == 1 ? "BUY SIGNAL ⬆️" : "SELL SIGNAL ⬇️");
   Print("Entry: ", DoubleToString(signal.entry, _Digits));
   Print("SL: ", DoubleToString(signal.sl, _Digits));
   Print("TP: ", DoubleToString(signal.tp, _Digits));
   Print("R:R: ", DoubleToString(MathAbs(signal.tp - signal.entry) / MathAbs(signal.entry - signal.sl), 2));
   Print("Confidence: ", signal.confidence, "%");
   Print("Reason: ", signal.reason);
   Print("═══════════════════════════════════════");
}

