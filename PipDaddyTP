//+------------------------------------------------------------------+
//| CHECK LIQUIDITY SWEEP                                             |
//+------------------------------------------------------------------+
bool CheckLiquiditySweep(bool bullish)
{
   double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
   double sweepDist = SMC_LiqSweepPips * pipValue;
   
   double recentLow = iLow(_Symbol, PERIOD_M5, 1);
   double recentHigh = iHigh(_Symbol, PERIOD_M5, 1);
   double recentClose = iClose(_Symbol, PERIOD_M5, 1);
   
   for(int i = 2; i < 20; i++)
   {
      if(bullish)
      {
         double prevLow = iLow(_Symbol, PERIOD_M5, i);
         if(recentLow < prevLow && recentClose > prevLow + sweepDist)
            return true;
      }
      else
      {
         double prevHigh = iHigh(_Symbol, PERIOD_M5, i);
         if(recentHigh > prevHigh && recentClose < prevHigh - sweepDist)
            return true;
      }
   }
   
   return false;
}

//+------------------------------------------------------------------+
//| CHECK ENGULFING CANDLE                                            |
//+------------------------------------------------------------------+
bool IsEngulfingCandle(bool bullish)
{
   double open0 = iOpen(_Symbol, PERIOD_M5, 1);
   double close0 = iClose(_Symbol, PERIOD_M5, 1);
   double open1 = iOpen(_Symbol, PERIOD_M5, 2);
   double close1 = iClose(_Symbol, PERIOD_M5, 2);
   double high = iHigh(_Symbol, PERIOD_M5, 1);
   double low = iLow(_Symbol, PERIOD_M5, 1);
   
   double body0 = MathAbs(close0 - open0);
   double body1 = MathAbs(close1 - open1);
   double range = high - low;
   
   if(range == 0) return false;
   
   double bodyPct = (body0 / range) * 100;
   
   if(bullish)
      return (close0 > open0 && close1 < open1 && close0 > open1 && 
              open0 < close1 && body0 > body1 && bodyPct > SMC_EngulfingBodyPct);
   else
      return (close0 < open0 && close1 > open1 && close0 < open1 && 
              open0 > close1 && body0 > body1 && bodyPct > SMC_EngulfingBodyPct);
}

//+------------------------------------------------------------------+
//| BITCOIN SIGNAL - Breakout Strategy                               |
//+------------------------------------------------------------------+
TradeSignal GetBitcoinSignal()
{
   TradeSignal signal;
   signal.valid = false;
   signal.confidence = 0;
   
   double high[], low[], close[];
   ArraySetAsSeries(high, true);
   ArraySetAsSeries(low, true);
   ArraySetAsSeries(close, true);
   
   if(CopyHigh(_Symbol, PERIOD_M5, 0, BTC_BreakoutPeriod + 1, high) < BTC_BreakoutPeriod + 1) return signal;
   if(CopyLow(_Symbol, PERIOD_M5, 0, BTC_BreakoutPeriod + 1, low) < BTC_BreakoutPeriod + 1) return signal;
   if(CopyClose(_Symbol, PERIOD_M5, 0, 2, close) < 2) return signal;
   
   double highestHigh = high[ArrayMaximum(high, 1, BTC_BreakoutPeriod)];
   double lowestLow = low[ArrayMinimum(low, 1, BTC_BreakoutPeriod)];
   
   double priceRange = highestHigh - lowestLow;
   bool highVolatility = (g_cache.atr > priceRange / BTC_VolatilityMult);
   
   // Bullish breakout
   if(close[0] > highestHigh && g_cache.fastMA > g_cache.slowMA && 
      g_cache.rsi > 50 && highVolatility)
   {
      signal.valid = true;
      signal.direction = 1;
      signal.entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      
      double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
      signal.sl = signal.entry - (BTC_SL_Pips * pipValue);
      double riskPips = MathAbs(signal.entry - signal.sl) / pipValue;
      signal.tp = signal.entry + (riskPips * BTC_TP_Mult * pipValue);
      
      signal.reason = "BTC BREAKOUT BUY: High break | RSI:" + DoubleToString(g_cache.rsi, 1);
      signal.confidence = 65 + (g_cache.rsi > 60 ? 10 : 0);
   }
   // Bearish breakout
   else if(close[0] < lowestLow && g_cache.fastMA < g_cache.slowMA && 
           g_cache.rsi < 50 && highVolatility)
   {
      signal.valid = true;
      signal.direction = -1;
      signal.entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
      
      double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
      signal.sl = signal.entry + (BTC_SL_Pips * pipValue);
      double riskPips = MathAbs(signal.entry - signal.sl) / pipValue;
      signal.tp = signal.entry - (riskPips * BTC_TP_Mult * pipValue);
      
      signal.reason = "BTC BREAKOUT SELL: Low break | RSI:" + DoubleToString(g_cache.rsi, 1);
      signal.confidence = 65 + (g_cache.rsi < 40 ? 10 : 0);
   }
   
   return signal;
}

