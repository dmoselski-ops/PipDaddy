}

//+------------------------------------------------------------------+
//| MAIN TICK HANDLER - Clean Event Flow                             |
//+------------------------------------------------------------------+
void OnTick()
{
   // Real-time UI updates (every second)
   if(UI_ShowPanel && TimeCurrent() - g_lastPanelUpdate >= 1)
   {
      UpdateInfoPanel();
      g_lastPanelUpdate = TimeCurrent();
      g_scanCounter++;
   }
   
   // Check for new bar
   datetime currentBarTime = iTime(_Symbol, PERIOD_M5, 0);
   if(currentBarTime == g_lastBarTime)
      return;
   
   g_lastBarTime = currentBarTime;
   
   // Daily reset check
   CheckDailyReset();
   
   // Update performance metrics
   UpdateDailyPnL();
   UpdateIndicatorCache();
   
   // Pre-trade validation
   if(!PreTradeValidation())
      return;
   
   // Analyze market conditions
   AnalyzeMarket();
   
   // Get trade signal
   TradeSignal signal = GenerateSignal();
   
   // Display signal info
   if(signal.valid)
      DisplaySignalInfo(signal);
   
   // Execute if valid
   if(signal.valid)
      ProcessSignal(signal);
   
   // Manage open positions
   ManageAllPositions();
}

//+------------------------------------------------------------------+
//| INDICATOR MANAGEMENT - Centralized                               |
//+------------------------------------------------------------------+
bool InitializeIndicators()
{
   g_handleFastMA = iMA(_Symbol, PERIOD_M5, Trend_FastMA, 0, MODE_EMA, PRICE_CLOSE);
   g_handleSlowMA = iMA(_Symbol, PERIOD_M5, Trend_SlowMA, 0, MODE_SMA, PRICE_CLOSE);
   g_handleRSI = iRSI(_Symbol, PERIOD_M5, Trend_RSI_Period, PRICE_CLOSE);
   g_handleATR = iATR(_Symbol, PERIOD_M5, 14);
   
   return (g_handleFastMA != INVALID_HANDLE && 
           g_handleSlowMA != INVALID_HANDLE &&
           g_handleRSI != INVALID_HANDLE && 
           g_handleATR != INVALID_HANDLE);
}

void ReleaseIndicators()
{
   if(g_handleFastMA != INVALID_HANDLE) IndicatorRelease(g_handleFastMA);
   if(g_handleSlowMA != INVALID_HANDLE) IndicatorRelease(g_handleSlowMA);
   if(g_handleRSI != INVALID_HANDLE) IndicatorRelease(g_handleRSI);
   if(g_handleATR != INVALID_HANDLE) IndicatorRelease(g_handleATR);
}

void UpdateIndicatorCache()
{
   // Only update if older than 5 seconds (performance optimization)
   if(TimeCurrent() - g_cache.updateTime < 5)
      return;
   
   double fastMA[], slowMA[], rsi[], atr[];
   ArraySetAsSeries(fastMA, true);
   ArraySetAsSeries(slowMA, true);
   ArraySetAsSeries(rsi, true);
   ArraySetAsSeries(atr, true);
   
   if(CopyBuffer(g_handleFastMA, 0, 0, 1, fastMA) > 0)
      g_cache.fastMA = fastMA[0];
   if(CopyBuffer(g_handleSlowMA, 0, 0, 1, slowMA) > 0)
      g_cache.slowMA = slowMA[0];
   if(CopyBuffer(g_handleRSI, 0, 0, 1, rsi) > 0)
      g_cache.rsi = rsi[0];
   if(CopyBuffer(g_handleATR, 0, 0, 1, atr) > 0)
      g_cache.atr = atr[0];
   
   g_cache.updateTime = TimeCurrent();
}

//+------------------------------------------------------------------+
//| PRE-TRADE VALIDATION - All Checks in One Place                   |
//+------------------------------------------------------------------+
bool PreTradeValidation()
{
   // Check spread
   if(!CheckSpread())
      return false;
   
   // Check account balance
   if(AccountInfoDouble(ACCOUNT_BALANCE) < 100)
   {
      Print("⚠️ Account balance too low");
      return false;
   }
   
   // Check risk limits
   if(g_dailyTradeCount >= Risk_MaxTradesPerDay)
   {
      Print("⚠️ Daily trade limit reached");
      return false;
   }
   
   double maxLoss = g_dailyStartBalance * (Risk_MaxDailyLoss / 100.0);
   if(g_dailyPnL <= -maxLoss)
   {
      Print("⚠️ Daily loss limit reached");
      return false;
   }
   
   // Check position limits
   if(CountOpenPositions() >= Pos_MaxOpen && !Pos_AllowReentry)
      return false;
   
   return true;
}

bool CheckSpread()
{
   long spread = SymbolInfoInteger(_Symbol, SYMBOL_SPREAD);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);
   double spreadPips = spread * point / (point * 10);
   
   return (spreadPips <= Filter_MaxSpread);
}

//+------------------------------------------------------------------+
//| SIGNAL GENERATION - Unified Entry Point                          |
//+------------------------------------------------------------------+
TradeSignal GenerateSignal()
{
   TradeSignal signal;
   signal.valid = false;
   
   // Route to appropriate strategy
   if(IsBitcoinSymbol() && BTC_Enable)
      signal = GetBitcoinSignal();
   else if(IsUSDJPYSymbol())
      signal = GetUSDJPYSignal();
   else
   {
      ENUM_STRATEGY_MODE strategy = GetActiveStrategy();
      if(strategy == STRATEGY_TREND)
         signal = GetTrendSignal();
      else
         signal = GetSMCSignal();
   }
   
   return signal;
}

//+------------------------------------------------------------------+
//| TREND STRATEGY - Optimized                                       |
//+------------------------------------------------------------------+
TradeSignal GetTrendSignal()
{
   TradeSignal signal;
   signal.valid = false;
   signal.confidence = 0;
   
   // Get indicator arrays
   double fastMA[], slowMA[], rsi[];
   ArraySetAsSeries(fastMA, true);
   ArraySetAsSeries(slowMA, true);
   ArraySetAsSeries(rsi, true);
   
   if(CopyBuffer(g_handleFastMA, 0, 0, 3, fastMA) < 3) return signal;
   if(CopyBuffer(g_handleSlowMA, 0, 0, 3, slowMA) < 3) return signal;
   if(CopyBuffer(g_handleRSI, 0, 0, 3, rsi) < 3) return signal;
   
   double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   // Bullish conditions
   bool maCrossUp = (fastMA[1] > slowMA[1] && fastMA[2] <= slowMA[2]);
   bool rsiOversold = (rsi[1] < Trend_RSI_Low && rsi[0] > rsi[1]);
   bool priceAboveMA = price > fastMA[0];
   bool uptrend = fastMA[0] > slowMA[0];
   
   if((maCrossUp || (uptrend && rsiOversold)) && priceAboveMA)
   {
      signal.valid = true;
      signal.direction = 1;
      signal.entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
      signal.sl = signal.entry - (g_cache.atr * Trend_ATR_SL);
      signal.tp = signal.entry + (g_cache.atr * Trend_ATR_TP);
      signal.reason = "TREND BUY: ";
      if(maCrossUp) signal.reason += "MA Cross↑ | ";
      if(rsiOversold) signal.reason += "RSI OS | ";
      signal.reason += StringFormat("RSI:%.1f", rsi[0]);
      signal.confidence = 70 + (maCrossUp ? 15 : 0) + (rsiOversold ? 15 : 0);
      
      if(!ValidateRiskReward(signal))
         signal.valid = false;
   }
   // Bearish conditions
   else
   {
      bool maCrossDown = (fastMA[1] < slowMA[1] && fastMA[2] >= slowMA[2]);
      bool rsiOverbought = (rsi[1] > Trend_RSI_High && rsi[0] < rsi[1]);
      bool priceBelowMA = price < fastMA[0];
      bool downtrend = fastMA[0] < slowMA[0];
      
      if((maCrossDown || (downtrend && rsiOverbought)) && priceBelowMA)
      {
         signal.valid = true;
         signal.direction = -1;
         signal.entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         signal.sl = signal.entry + (g_cache.atr * Trend_ATR_SL);
         signal.tp = signal.entry - (g_cache.atr * Trend_ATR_TP);
         signal.reason = "TREND SELL: ";
         if(maCrossDown) signal.reason += "MA Cross↓ | ";
         if(rsiOverbought) signal.reason += "RSI OB | ";
         signal.reason += StringFormat("RSI:%.1f", rsi[0]);
         signal.confidence = 70 + (maCrossDown ? 15 : 0) + (rsiOverbought ? 15 : 0);
         
         if(!ValidateRiskReward(signal))
            signal.valid = false;
      }
   }
   
   return signal;
}

//+------------------------------------------------------------------+
//| SMC STRATEGY - Optimized with Caching                            |
//+------------------------------------------------------------------+
TradeSignal GetSMCSignal()
{
   TradeSignal signal;
   signal.valid = false;
   signal.confidence = 0;
   
   // Update order blocks (cached for 1 hour)
   if(TimeCurrent() - g_lastOBScan > 3600)
   {
      ScanOrderBlocks();
      g_lastOBScan = TimeCurrent();
   }
   
   double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
   
   // Check if price in bullish OB
   if(g_bullishOB.strength >= SMC_OB_MinStrength && 
      price >= g_bullishOB.low && price <= g_bullishOB.high)
   {
      // Check OB age
      int ageHours = (int)((TimeCurrent() - g_bullishOB.time) / 3600);
      if(ageHours > SMC_OB_MaxAgeHours)
         return signal;
      
      bool hasConfirmation = !SMC_RequireEngulfing || IsEngulfingCandle(true);
      
      if(hasConfirmation)
      {
         signal.valid = true;
         signal.direction = 1;
         signal.entry = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
         
         double slPips = IsXAUUSDSymbol() ? XAUUSD_SL_Pips : 15;
         double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
         
         signal.sl = g_bullishOB.low - (slPips * pipValue);
         double riskPips = MathAbs(signal.entry - signal.sl) / pipValue;
         double tpMult = IsXAUUSDSymbol() ? XAUUSD_TP_Mult : Risk_MinRR;
         signal.tp = signal.entry + (riskPips * tpMult * pipValue);
         
         signal.reason = StringFormat("SMC BUY: OB Age:%dh | Str:%.1f", ageHours, g_bullishOB.strength);
         if(CheckLiquiditySweep(true)) signal.reason += " | LiqSweep";
         if(hasConfirmation && SMC_RequireEngulfing) signal.reason += " | Engulf";
         
         signal.confidence = 60 + (g_bullishOB.strength * 5);
         if(CheckLiquiditySweep(true)) signal.confidence += 15;
         if(hasConfirmation && SMC_RequireEngulfing) signal.confidence += 10;
         
         if(signal.confidence < SMC_MinConfidence)
            signal.valid = false;
      }
   }
   // Check if price in bearish OB
   else if(g_bearishOB.strength >= SMC_OB_MinStrength && 
           price >= g_bearishOB.low && price <= g_bearishOB.high)
   {
      int ageHours = (int)((TimeCurrent() - g_bearishOB.time) / 3600);
      if(ageHours > SMC_OB_MaxAgeHours)
         return signal;
      
      bool hasConfirmation = !SMC_RequireEngulfing || IsEngulfingCandle(false);
      
      if(hasConfirmation)
      {
         signal.valid = true;
         signal.direction = -1;
         signal.entry = SymbolInfoDouble(_Symbol, SYMBOL_BID);
         
         double slPips = IsXAUUSDSymbol() ? XAUUSD_SL_Pips : 15;
         double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
         
         signal.sl = g_bearishOB.high + (slPips * pipValue);
         double riskPips = MathAbs(signal.entry - signal.sl) / pipValue;
         double tpMult = IsXAUUSDSymbol() ? XAUUSD_TP_Mult : Risk_MinRR;
         signal.tp = signal.entry - (riskPips * tpMult * pipValue);
         
         signal.reason = StringFormat("SMC SELL: OB Age:%dh | Str:%.1f", ageHours, g_bearishOB.strength);
         if(CheckLiquiditySweep(false)) signal.reason += " | LiqSweep";
         if(hasConfirmation && SMC_RequireEngulfing) signal.reason += " | Engulf";
         
         signal.confidence = 60 + (g_bearishOB.strength * 5);
         if(CheckLiquiditySweep(false)) signal.confidence += 15;
         if(hasConfirmation && SMC_RequireEngulfing) signal.confidence += 10;
         
         if(signal.confidence < SMC_MinConfidence)
            signal.valid = false;
      }
   }
   
   return signal;
}

//+------------------------------------------------------------------+
//| SCAN ORDER BLOCKS - Cached Hourly                                |
//+------------------------------------------------------------------+
void ScanOrderBlocks()
{
   // Reset
   ResetOrderBlocks();
   
   // Scan for bullish OB
   for(int i = 2; i < SMC_OB_Lookback; i++)
   {
      double close1 = iClose(_Symbol, PERIOD_M5, i);
      double open1 = iOpen(_Symbol, PERIOD_M5, i);
      double high0 = iHigh(_Symbol, PERIOD_M5, i-1);
      double low1 = iLow(_Symbol, PERIOD_M5, i);
      double high1 = iHigh(_Symbol, PERIOD_M5, i);
      
      if(close1 < open1 && high0 > high1)
      {
         double obSize = high1 - low1;
         double upMove = high0 - low1;
         
         if(obSize > 0)
         {
            double strength = upMove / obSize;
            
            if(strength > g_bullishOB.strength)
            {
               g_bullishOB.high = high1;
               g_bullishOB.low = low1;
               g_bullishOB.time = iTime(_Symbol, PERIOD_M5, i);
               g_bullishOB.strength = MathMin(strength, 10.0);
               g_bullishOB.isBullish = true;
               g_bullishOB.drawn = false;
            }
         }
      }
   }
   
   // Scan for bearish OB
   for(int i = 2; i < SMC_OB_Lookback; i++)
   {
      double close1 = iClose(_Symbol, PERIOD_M5, i);
      double open1 = iOpen(_Symbol, PERIOD_M5, i);
      double low0 = iLow(_Symbol, PERIOD_M5, i-1);
      double high1 = iHigh(_Symbol, PERIOD_M5, i);
      double low1 = iLow(_Symbol, PERIOD_M5, i);
      
      if(close1 > open1 && low0 < low1)
      {
         double obSize = high1 - low1;
         double downMove = high1 - low0;
         
         if(obSize > 0)
         {
            double strength = downMove / obSize;
            
            if(strength > g_bearishOB.strength)
            {
               g_bearishOB.high = high1;
               g_bearishOB.low = low1;
               g_bearishOB.time = iTime(_Symbol, PERIOD_M5, i);
               g_bearishOB.strength = MathMin(strength, 10.0);
               g_bearishOB.isBullish = false;
               g_bearishOB.drawn = false;
            }
         }
      }
   }
   
   // Draw order blocks
   if(SMC_DrawOrderBlocks)
   {
      if(g_bullishOB.strength >= SMC_OB_MinStrength && !g_bullishOB.drawn)
      {
         DrawOrderBlock(g_bullishOB);
         g_bullishOB.drawn = true;
      }
      if(g_bearishOB.strength >= SMC_OB_MinStrength && !g_bearishOB.drawn)
      {
         DrawOrderBlock(g_bearishOB);
         g_bearishOB.drawn = true;
      }
   }
}

//+------------------------------------------------------------------+
//| MULTI-LEVEL TP MANAGEMENT - Partial Profit Taking                |
//+------------------------------------------------------------------+
void ManageMultiLevelTP(ulong ticket, double openPrice, double currentPrice, double profitPips,
                        ENUM_POSITION_TYPE posType, double currentSL, double currentTP, double pipValue)
{
   // Find tracker for this position
   int trackerIndex = FindTPTracker(ticket);
   if(trackerIndex < 0)
      return;
   
   PositionTPTracker tracker = g_tpTrackers[trackerIndex];
   double currentLot = PositionGetDouble(POSITION_VOLUME);
   
   // TP1 Hit - Close 30% of position
   if(!tracker.tp1_hit && profitPips >= TP1_Pips)
   {
      double closeVolume = NormalizeDouble(tracker.originalLot * (TP1_ClosePercent / 100.0), 2);
      closeVolume = MathMax(SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN), closeVolume);
      closeVolume = MathMin(currentLot, closeVolume);
      
      if(ClosePartialPosition(ticket, closeVolume))
      {
         g_tpTrackers[trackerIndex].tp1_hit = true;
         
         Print("═══════════════════════════════════════");
         Print("🎯 TP1 HIT - Partial Close");
         Print("Profit: +", DoubleToString(profitPips, 1), " pips");
         Print("Closed: ", closeVolume, " lots (", TP1_ClosePercent, "%)");
         Print("Remaining: ", DoubleToString(currentLot - closeVolume, 2), " lots");
         Print("═══════════════════════════════════════");
         
         // Move to breakeven after TP1
         if(TP_MoveToBreakeven && !tracker.be_moved)
         {
            double bePrice = openPrice + (TP_BreakevenPlus * pipValue * (posType == POSITION_TYPE_BUY ? 1 : -1));
            ModifyPosition(ticket, bePrice, 0);
            g_tpTrackers[trackerIndex].be_moved = true;
            Print("✅ SL moved to BE + ", TP_BreakevenPlus, " pips");
         }
      }
   }
   
   // TP2 Hit - Close another 30%
   if(tracker.tp1_hit && !tracker.tp2_hit && profitPips >= TP2_Pips)
   {
      double closeVolume = NormalizeDouble(tracker.originalLot * (TP2_ClosePercent / 100.0), 2);
      closeVolume = MathMax(SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN), closeVolume);
      closeVolume = MathMin(currentLot, closeVolume);
      
      if(ClosePartialPosition(ticket, closeVolume))
      {
         g_tpTrackers[trackerIndex].tp2_hit = true;
         
         Print("═══════════════════════════════════════");
         Print("🎯 TP2 HIT - Partial Close");
         Print("Profit: +", DoubleToString(profitPips, 1), " pips");
         Print("Closed: ", closeVolume, " lots (", TP2_ClosePercent, "%)");
         Print("Remaining: ", DoubleToString(currentLot - closeVolume, 2), " lots");
         Print("═══════════════════════════════════════");
         
         // Trail remaining position aggressively
         double trailDist = 30 * pipValue; // Tight 30 pip trail
         double newSL = (posType == POSITION_TYPE_BUY) ? 
                        currentPrice - trailDist : 
                        currentPrice + trailDist;
         
         if((posType == POSITION_TYPE_BUY && newSL > currentSL) ||
            (posType == POSITION_TYPE_SELL && (newSL < currentSL || currentSL == 0)))
         {
            ModifyPosition(ticket, newSL, 0);
            Print("📈 Aggressive trail activated: 30 pips");
         }
      }
   }
   
   // TP3 Hit - Close remaining position OR trail to exit
   if(tracker.tp2_hit && profitPips >= TP3_Pips)
   {
      if(ClosePartialPosition(ticket, currentLot))
      {
         Print("═══════════════════════════════════════");
         Print("🏆 TP3 HIT - Full Close");
         Print("Final Profit: +", DoubleToString(profitPips, 1), " pips");
         Print("Position fully closed!");
         Print("═══════════════════════════════════════");
         
         RemoveTPTracker(ticket);
      }
   }
   
   // Trailing stop for remaining position after TP2
   if(tracker.tp2_hit && profitPips > TP2_Pips + 20)
   {
      double trailDist = 25 * pipValue; // Very tight trail
      double newSL = (posType == POSITION_TYPE_BUY) ? 
                     currentPrice - trailDist : 
                     currentPrice + trailDist;
      
      if((posType == POSITION_TYPE_BUY && newSL > currentSL) ||
         (posType == POSITION_TYPE_SELL && (newSL < currentSL || currentSL == 0)))
      {
         ModifyPosition(ticket, newSL, 0);
      }
   }
}

//+------------------------------------------------------------------+
//| CLOSE PARTIAL POSITION                                            |
//+------------------------------------------------------------------+
bool ClosePartialPosition(ulong ticket, double volume)
{
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   if(!PositionSelectByTicket(ticket))
      return false;
   
   ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
   
   request.action = TRADE_ACTION_DEAL;
   request.position = ticket;
   request.symbol = _Symbol;
   request.volume = volume;
   request.type = (posType == POSITION_TYPE_BUY) ? ORDER_TYPE_SELL : ORDER_TYPE_BUY;
   request.price = (posType == POSITION_TYPE_BUY) ? 
                   SymbolInfoDouble(_Symbol, SYMBOL_BID) : 
                   SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   request.deviation = IsXAUUSDSymbol() ? XAUUSD_Deviation : 20;
   request.magic = Config_MagicNumber;
   request.type_filling = GetFillingMode();
   
   bool orderResult = OrderSend(request, result);
   
   if(!orderResult || result.retcode != TRADE_RETCODE_DONE)
   {
      Print("❌ Partial close failed: ", GetErrorDescription(result.retcode));
      return false;
   }
   
   return true;
}

//+------------------------------------------------------------------+
//| TP TRACKER MANAGEMENT                                             |
//+------------------------------------------------------------------+
void AddTPTracker(ulong ticket, double originalLot)
{
   int size = ArraySize(g_tpTrackers);
   ArrayResize(g_tpTrackers, size + 1);
   
   g_tpTrackers[size].ticket = ticket;
   g_tpTrackers[size].tp1_hit = false;
   g_tpTrackers[size].tp2_hit = false;
   g_tpTrackers[size].be_moved = false;
   g_tpTrackers[size].originalLot = originalLot;
   
   Print("📊 Multi-TP tracker added for ticket #", ticket);
}

int FindTPTracker(ulong ticket)
{
   for(int i = 0; i < ArraySize(g_tpTrackers); i++)
   {
      if(g_tpTrackers[i].ticket == ticket)
         return i;
   }
   return -1;
}

void RemoveTPTracker(ulong ticket)
{
   int index = FindTPTracker(ticket);
   if(index < 0) return;
   
   int size = ArraySize(g_tpTrackers);
   
   // Shift array elements
   for(int i = index; i < size - 1; i++)
   {
      g_tpTrackers[i] = g_tpTrackers[i + 1];
   }
   
   ArrayResize(g_tpTrackers, size - 1);
   Print("📊 Multi-TP tracker removed for ticket #", ticket);
}

