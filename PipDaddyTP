//+------------------------------------------------------------------+
//| PROCESS SIGNAL - Unified Execution Logic                         |
//+------------------------------------------------------------------+
void ProcessSignal(TradeSignal &signal)
{
   int openPos = CountOpenPositions();
   
   // No positions - open fresh trade
   if(openPos == 0)
   {
      ExecuteTrade(signal);
      return;
   }
   
   // Check reentry conditions
   if(Pos_AllowReentry && g_reentry.count < Pos_MaxReentries)
   {
      if(ShouldReenter(signal))
      {
         ExecuteTrade(signal);
         g_reentry.count++;
         Print("✅ Reentry #", g_reentry.count, " executed");
      }
   }
}

//+------------------------------------------------------------------+
//| SHOULD REENTER - Universal Reentry Logic                         |
//+------------------------------------------------------------------+
bool ShouldReenter(TradeSignal &signal)
{
   // Must have initial position
   if(g_reentry.entryPrice == 0)
      return false;
   
   // Same direction only
   if(signal.direction != g_reentry.direction)
      return false;
   
   // Check distance
   double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
   double reentryDist = Pos_ReentryDistance * pipValue;
   double distance = MathAbs(signal.entry - g_reentry.entryPrice);
   
   if(distance > reentryDist * 2)
      return false;
   
   // Time cooldown (5 minutes)
   if(TimeCurrent() - g_reentry.lastTime < 300)
      return false;
   
   return true;
}

//+------------------------------------------------------------------+
//| EXECUTE TRADE - Smart Risk + Symbol Adjustments                  |
//+------------------------------------------------------------------+
void ExecuteTrade(TradeSignal &signal)
{
   // Calculate lot size with smart risk
   double lotSize = CalculateSmartLotSize(signal.entry, signal.sl);
   
   // Apply symbol-specific adjustments
   lotSize = AdjustLotForSymbol(lotSize);
   
   // Validate lot size
   double minLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
   if(lotSize < minLot)
   {
      Print("⚠️ Lot size too small: ", lotSize);
      return;
   }
   
   // Prepare order
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   request.action = TRADE_ACTION_DEAL;
   request.symbol = _Symbol;
   request.volume = lotSize;
   request.type = (signal.direction == 1) ? ORDER_TYPE_BUY : ORDER_TYPE_SELL;
   request.price = signal.entry;
   request.sl = signal.sl;
   request.tp = signal.tp;
   request.deviation = IsXAUUSDSymbol() ? XAUUSD_Deviation : 20;
   request.magic = Config_MagicNumber;
   request.comment = Config_CommentPrefix;
   
   // Set filling mode
   request.type_filling = GetFillingMode();
   
   // Send order
   bool orderResult = OrderSend(request, result);
   if(orderResult)
   {
      if(result.retcode == TRADE_RETCODE_DONE)
      {
         Print("═══════════════════════════════════════");
         Print("✅ TRADE OPENED: ", signal.direction == 1 ? "BUY ⬆️" : "SELL ⬇️");
         Print("Ticket: #", result.order);
         Print("Entry: ", DoubleToString(signal.entry, _Digits));
         Print("SL: ", DoubleToString(signal.sl, _Digits));
         Print("TP: ", DoubleToString(signal.tp, _Digits));
         Print("Lot: ", lotSize);
         Print("Reason: ", signal.reason);
         Print("Confidence: ", signal.confidence, "%");
         Print("═══════════════════════════════════════");
         
         g_dailyTradeCount++;
         
         // Track for reentry
         if(g_reentry.entryPrice == 0)
         {
            g_reentry.entryPrice = signal.entry;
            g_reentry.direction = signal.direction;
            g_reentry.count = 0;
         }
         g_reentry.lastTime = TimeCurrent();
         
         // Add to alert tracking
         int size = ArraySize(g_alertTickets);
         ArrayResize(g_alertTickets, size + 1);
         ArrayResize(g_lastAlertLevel, size + 1);
         g_alertTickets[size] = result.order;
         g_lastAlertLevel[size] = 0;
         
         // Add to Multi-TP tracker if enabled
         if(UseMultiTP)
         {
            AddTPTracker(result.order, lotSize);
         }
      }
      else
      {
         Print("❌ Trade failed: ", result.retcode, " - ", GetErrorDescription(result.retcode));
      }
   }
   else
   {
      Print("❌ OrderSend failed with error: ", GetLastError());
   }
}

//+------------------------------------------------------------------+
//| SMART LOT CALCULATION - Risk Scaling                             |
//+------------------------------------------------------------------+
double CalculateSmartLotSize(double entry, double sl)
{
   if(Risk_UseFixedLot)
      return Risk_FixedLotSize;
   
   double balance = AccountInfoDouble(ACCOUNT_BALANCE);
   double currentRisk = Risk_BasePercent;
   
   // Smart risk scaling
   if(Risk_SmartScaling)
   {
      double profitPct = ((balance - g_dailyStartBalance) / g_dailyStartBalance) * 100;
      
      if(profitPct > 0)
      {
         int steps = (int)(profitPct / Risk_ScaleEveryPct);
         currentRisk = Risk_BasePercent + (steps * 0.5);
         currentRisk = MathMin(currentRisk, Risk_MaxPercent);
         
         if(steps > 0)
            Print("📈 Smart Risk: +", DoubleToString(profitPct, 1), 
                  "% → Risk scaled to ", DoubleToString(currentRisk, 1), "%");
      }
      else if(profitPct < -5)
      {
         currentRisk = Risk_BasePercent * 0.5;
         Print("⚠️ Smart Risk: ", DoubleToString(profitPct, 1), 
               "% → Risk reduced to ", DoubleToString(currentRisk, 1), "%");
      }
   }
   
   double riskAmount = balance * (currentRisk / 100.0);
   double slDistance = MathAbs(entry - sl);
   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
   double tickSize = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
   
   if(tickSize == 0) return 0;
   
   double lotSize = riskAmount / (slDistance / tickSize * tickValue);
   
   // Normalize
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   double maxLot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
   
   lotSize = MathFloor(lotSize / lotStep) * lotStep;
   lotSize = MathMax(SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN), MathMin(maxLot, lotSize));
   
   return lotSize;
}

//+------------------------------------------------------------------+
//| ADJUST LOT FOR SYMBOL                                             |
//+------------------------------------------------------------------+
double AdjustLotForSymbol(double baseLot)
{
   double multiplier = 1.0;
   
   if(IsBitcoinSymbol())
      multiplier = Lot_BTC_Pct / 100.0;
   else if(IsXAUUSDSymbol())
      multiplier = Lot_XAUUSD_Pct / 100.0;
   else if(IsUSDJPYSymbol())
      multiplier = Lot_USDJPY_Pct / 100.0;
   else if(IsIndexSymbol())
      multiplier = Lot_Index_Pct / 100.0;
   else
      multiplier = Lot_Forex_Pct / 100.0;
   
   double adjusted = baseLot * multiplier;
   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
   
   adjusted = MathFloor(adjusted / lotStep) * lotStep;
   adjusted = MathMax(SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN), adjusted);
   
   return adjusted;
}

//+------------------------------------------------------------------+
//| MANAGE ALL POSITIONS - Trailing & Break-Even                     |
//+------------------------------------------------------------------+
void ManageAllPositions()
{
   bool hasPositions = false;
   
   for(int i = PositionsTotal() - 1; i >= 0; i--)
   {
      ulong ticket = PositionGetTicket(i);
      if(ticket > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol &&
         PositionGetInteger(POSITION_MAGIC) == Config_MagicNumber)
      {
         hasPositions = true;
         ManagePosition(ticket);
      }
   }
   
   // Reset reentry if no positions
   if(!hasPositions)
      ResetReentryTracker();
}

//+------------------------------------------------------------------+
//| MANAGE SINGLE POSITION                                            |
//+------------------------------------------------------------------+
void ManagePosition(ulong ticket)
{
   if(!PositionSelectByTicket(ticket))
      return;
      
   double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
   double currentSL = PositionGetDouble(POSITION_SL);
   double currentTP = PositionGetDouble(POSITION_TP);
   ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger(POSITION_TYPE);
   
   double currentPrice = (posType == POSITION_TYPE_BUY) ? 
                         SymbolInfoDouble(_Symbol, SYMBOL_BID) : 
                         SymbolInfoDouble(_Symbol, SYMBOL_ASK);
   
   double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
   double profitPips = (posType == POSITION_TYPE_BUY) ? 
                       (currentPrice - openPrice) / pipValue : 
                       (openPrice - currentPrice) / pipValue;
   
   // Check profit alert
   CheckProfitAlert(ticket, profitPips);
   
   // Multi-Level TP Management (priority) - Handles its own BE logic
   if(UseMultiTP)
   {
      ManageMultiLevelTP(ticket, openPrice, currentPrice, profitPips, posType, currentSL, currentTP, pipValue);
      return; // Exit here - Multi-TP handles everything including BE
   }
   
   // === STANDARD MANAGEMENT (Only runs if Multi-TP is disabled) ===
   
   // XAUUSD specific management
   if(IsXAUUSDSymbol())
   {
      ManageXAUUSDPosition(ticket, openPrice, currentSL, currentTP, posType, currentPrice, profitPips);
   }
   else
   {
      // Standard Break-Even (only if Multi-TP is OFF)
      if(Pos_UseBreakEven && profitPips >= Pos_BreakEvenTrigger)
      {
         double bePrice = openPrice + (Pos_BreakEvenPlus * pipValue * (posType == POSITION_TYPE_BUY ? 1 : -1));
         
         if((posType == POSITION_TYPE_BUY && currentSL < bePrice) ||
            (posType == POSITION_TYPE_SELL && (currentSL > bePrice || currentSL == 0)))
         {
            ModifyPosition(ticket, bePrice, currentTP);
            Print("✅ Standard Break-even activated at ", DoubleToString(profitPips, 1), " pips");
         }
      }
      
      // Trailing stop (only if Multi-TP is OFF)
      if(profitPips >= Pos_TrailActivate)
      {
         double trailDist = Pos_TrailDistance * pipValue;
         double newSL = (posType == POSITION_TYPE_BUY) ? 
                        currentPrice - trailDist : 
                        currentPrice + trailDist;
         
         if((posType == POSITION_TYPE_BUY && newSL > currentSL && newSL > openPrice) ||
            (posType == POSITION_TYPE_SELL && (newSL < currentSL || currentSL == 0) && newSL < openPrice))
         {
            ModifyPosition(ticket, newSL, currentTP);
            Print("📈 Standard Trailing SL: ", DoubleToString(profitPips, 1), " pips");
         }
      }
   }
}

//+------------------------------------------------------------------+
//| MANAGE XAUUSD POSITION - Special Handling                        |
//+------------------------------------------------------------------+
void ManageXAUUSDPosition(ulong ticket, double openPrice, double currentSL, double currentTP,
                          ENUM_POSITION_TYPE posType, double currentPrice, double profitPips)
{
   double pipValue = SymbolInfoDouble(_Symbol, SYMBOL_POINT) * 10;
   
   // Break-even at 30 pips
   if(profitPips >= XAUUSD_BreakEvenPips)
   {
      double bePrice = openPrice;
      
      if((posType == POSITION_TYPE_BUY && currentSL < bePrice) ||
         (posType == POSITION_TYPE_SELL && (currentSL > bePrice || currentSL == 0)))
      {
         ModifyPosition(ticket, bePrice, currentTP);
         Print("✅ XAUUSD Break-even at ", DoubleToString(bePrice, _Digits));
      }
   }
   
   // Trail at 50 pips after break-even
   if(profitPips > XAUUSD_BreakEvenPips)
   {
      double trailDist = XAUUSD_TrailPips * pipValue;
      double newSL = (posType == POSITION_TYPE_BUY) ? 
                     currentPrice - trailDist : 
                     currentPrice + trailDist;
      
      if((posType == POSITION_TYPE_BUY && newSL > currentSL && newSL > openPrice) ||
         (posType == POSITION_TYPE_SELL && (newSL < currentSL || currentSL == 0) && newSL < openPrice))
      {
         ModifyPosition(ticket, newSL, currentTP);
         Print("📈 XAUUSD Trail: ", DoubleToString(profitPips, 1), " pips");
      }
   }
}

//+------------------------------------------------------------------+
//| CHECK PROFIT ALERT                                                |
//+------------------------------------------------------------------+
void CheckProfitAlert(ulong ticket, double profitPips)
{
   if(!Alert_Enable || profitPips < Alert_ProfitPips)
      return;
   
   for(int i = 0; i < ArraySize(g_alertTickets); i++)
   {
      if(g_alertTickets[i] == ticket && g_lastAlertLevel[i] < Alert_ProfitPips)
      {
         Alert("🎯 ", _Symbol, " reached +", DoubleToString(profitPips, 1), " pips!");
         g_lastAlertLevel[i] = profitPips;
         break;
      }
   }
}

//+------------------------------------------------------------------+
//| MODIFY POSITION                                                   |
//+------------------------------------------------------------------+
void ModifyPosition(ulong ticket, double sl, double tp)
{
   MqlTradeRequest request = {};
   MqlTradeResult result = {};
   
   request.action = TRADE_ACTION_SLTP;
   request.position = ticket;
   request.symbol = _Symbol;
   request.sl = sl;
   request.tp = tp;
   
   if(!OrderSend(request, result))
   {
      Print("❌ Modify failed: ", GetLastError());
   }
}

